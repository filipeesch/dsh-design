{
  "name": "@filipeesch/dsh-design-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "eof": "node scripts/check-eof.mjs",
    "check": "pnpm run build && pnpm run typecheck:types && pnpm run lint && pnpm run format && pnpm run eof && pnpm run test",
    "typecheck:types": "tsc -p tsconfig.types.json --pretty false",
    "pack:bundle": "pnpm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
