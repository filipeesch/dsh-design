{
  "name": "@filipeesch/dsh-design-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Installable DSH bundle for the design plugin",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./host": "./lib/host.js",
    "./tools": "./lib/tools.js",
    "./preset": "./lib/preset.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs --only bundle",
    "test": "vitest run --root ../.. packages/bundle/tests --passWithNoTests"
  }
}
